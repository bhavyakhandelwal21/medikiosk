# Copy this file to .env and replace the placeholder values.
GEMINI_API_KEY=replace_with_a_valid_gemini_api_key
# Optional: additional keys used for failover.
GEMINI_BACKUP_KEY_1=
GEMINI_BACKUP_KEY_2=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:3000

# Optional SQLAlchemy URL. Defaults to ./medikiosk.db.
DATABASE_URL=sqlite:///./medikiosk.db

# Required in production. Used to sign login tokens.
AUTH_SECRET=replace_with_a_long_random_secret

# Optional attached chatbot API. If unavailable, the integrated app uses its local demo engine.
CHATBOT_URL=http://localhost:3001
